global
    log /dev/log local0
    maxconn 4096
    daemon

defaults
    mode http
    timeout connect 5s
    timeout client  30s
    timeout server  30s
    option httplog

frontend web_front
    bind *:80
    default_backend web_servers

backend web_servers
    balance roundrobin
    option httpchk GET /
    server web1 192.168.56.31:80 check
    server web2 192.168.56.32:80 check

listen stats
    bind *:8404
    stats enable
    stats uri /stats
    stats refresh 5s
