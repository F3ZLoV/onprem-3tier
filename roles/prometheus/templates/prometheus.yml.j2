global:
  scrape_interval: {{ prometheus_scrape_interval }}

rule_files:
  - {{ prometheus_dir }}/alert_rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:9093']

scrape_configs:
  - job_name: node
    static_configs:
{% for host in groups['all'] | sort %}
      - targets: ['{{ hostvars[host].ansible_host }}:9100']
        labels:
          instance: {{ host }}
{% endfor %}
